{
  "name": "interview-system-backend",
  "version": "1.0.0",
  "description": "Neon PostgreSQL backend for the global interview scheduling system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "admin:reset-password": "node scripts/resetAdministratorPassword.js",
    "db:schema": "node scripts/applySchema.js",
    "db:migrate:supabase": "node scripts/migrateSupabaseToNeon.js",
    "test": "npm run test:prepare && npm run test:frontend && npm run test:comprehensive && npm run test:integration",
    "test:prepare": "node scripts/resetTestDatabase.js",
    "test:integration": "node scripts/integration20.js",
    "test:comprehensive": "node scripts/comprehensiveApi.js",
    "test:frontend": "node scripts/frontendIntegrity.js"
  },
  "keywords": [
    "interview",
    "scheduling",
    "express",
    "neon",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
